---
// Sin formulario y sin lista de correo: un enlace directo. No hay servidor que
// pueda fallar ni envío que se pueda perder — el correo llega a la bandeja.
interface Props { compacto?: boolean; }
const { compacto = false } = Astro.props;
const CORREO = 'sdagerj@gmail.com';
const INSTAGRAM = 'https://instagram.com/yomevoyconel30';
---
<section class={`escribeme ${compacto ? 'compacto' : ''}`}>
  <h2>Si quieres saber de mí, escríbeme</h2>
  <p class="honesto">
    Sin listas y sin suscripciones. Me escribes y te contesto yo.
  </p>

  <div class="botones">
    <a class="boton" href={`mailto:${CORREO}?subject=El%20N%C3%BAmero`}>{CORREO}</a>
    <a class="boton secundario" href={INSTAGRAM} rel="noopener">Instagram</a>
  </div>
</section>

<style>
  .escribeme {
    margin-top: var(--aire);
    padding: 2.25rem 1.75rem;
    background: var(--navy-hondo);
    border: 1px solid var(--crema-linea);
    border-radius: 4px;
  }
  .escribeme.compacto { margin-top: 2rem; padding: 1.75rem 1.5rem; }
  .escribeme h2 { font-size: var(--t-h2); margin-bottom: 0.75rem; }
  .honesto {
    font-size: var(--t-menor); color: var(--crema-tenue);
    line-height: 1.6; margin-bottom: 1.5rem;
  }

  .botones { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .boton {
    padding: 0.85rem 1.6rem; border-radius: 3px;
    font-size: 1.05rem; font-weight: 600; text-decoration: none;
    color: var(--navy); background: var(--sol);
    overflow-wrap: anywhere;
  }
  .boton:hover { background: var(--crema); }
  .boton.secundario {
    background: transparent; color: var(--crema);
    border: 1px solid var(--crema-linea);
  }
  .boton.secundario:hover { border-color: var(--sol); color: var(--sol); }

  @media (max-width: 26rem) {
    .botones { flex-direction: column; }
    .boton { text-align: center; }
  }
</style>
