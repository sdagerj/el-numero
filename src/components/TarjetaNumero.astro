---
import { formatearFecha } from '../lib/editoriales';
import { NOMBRE_CANTERA } from '../content.config';
interface Props { editorial: any; }
const { editorial: e } = Astro.props;
const d = e.data;
const largo = d.numero.length;
const escala = largo <= 3 ? 1 : largo <= 5 ? 0.7 : 0.5;
---
<a class="tarjeta" href={`/n/${e.id}/`}>
  <span class="t-numero" style={`--escala:${escala}`}>{d.numero}</span>
  <span class="t-cuerpo">
    <span class="t-cantera">{NOMBRE_CANTERA[d.cantera]}</span>
    <span class="t-titulo">{d.titulo}</span>
    <span class="t-fecha">{formatearFecha(d.fecha)}</span>
  </span>
</a>

<style>
  .tarjeta {
    display: flex; align-items: baseline; gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--crema-linea);
    text-decoration: none; color: inherit;
  }
  .tarjeta:hover .t-titulo { color: var(--sol); }
  .tarjeta:hover .t-numero { transform: translateY(-2px); }
  .t-numero {
    flex: 0 0 auto; min-width: 3.2ch; text-align: center;
    font-size: calc(clamp(2.6rem, 11vw, 3.6rem) * var(--escala, 1));
    line-height: 1; font-weight: 600; color: var(--sol);
    transition: transform 0.18s ease;
  }
  .t-cuerpo { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .t-cantera { font-size: var(--t-mini); letter-spacing: 0.16em; text-transform: uppercase; color: var(--mint); }
  .t-titulo { font-size: 1.35rem; font-weight: 600; line-height: 1.25; transition: color 0.18s ease; }
  .t-fecha { font-size: var(--t-mini); color: var(--crema-tenue); }
</style>
